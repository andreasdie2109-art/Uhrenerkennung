<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horologium — Präzise Uhren-Identifikation mit KI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: {
                            50: '#fbf8ee',
                            100: '#f5edd4',
                            200: '#ebd9a9',
                            300: '#dfbe75',
                            400: '#d4a34b',
                            500: '#bd8832',
                            600: '#9e6c27',
                            700: '#7e5322',
                            800: '#684422',
                            900: '#573820',
                            950: '#321e0f',
                        },
                        watchdark: {
                            900: '#0b0c10',
                            800: '#12141c',
                            700: '#1a1d26',
                            600: '#262a36'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .cinzel {
            font-family: 'Cinzel', serif;
        }
        .glass-panel {
            background: rgba(26, 29, 38, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(213, 163, 75, 0.15);
        }
    </style>
</head>
<body class="bg-watchdark-900 text-gray-100 min-h-screen flex flex-col selection:bg-gold-500 selection:text-black">

    <!-- Header -->
    <header class="glass-panel sticky top-0 z-50 border-b border-gold-900/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-gold-500/10 border border-gold-500/40 flex items-center justify-center text-gold-400">
                    <i data-lucide="watch" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="cinzel text-xl sm:text-2xl font-bold tracking-wider text-gold-300">HOROLOGIUM</span>
                    <span class="block text-[10px] tracking-widest text-gray-400 uppercase">Precision Watch Intelligence</span>
                </div>
            </div>
            
            <!-- API Key Status / Setting -->
            <div class="flex items-center space-x-3">
                <div id="api-status-badge" class="hidden sm:flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs bg-red-500/10 text-red-400 border border-red-500/30">
                    <span class="w-2 h-2 rounded-full bg-red-400"></span>
                    <span id="api-status-text">API-Key fehlt</span>
                </div>
                <button onclick="openApiKeyModal()" class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-watchdark-700 hover:bg-watchdark-600 border border-gold-500/20 text-gold-300 transition-all text-xs font-medium">
                    <i data-lucide="key" class="w-4 h-4"></i>
                    <span class="hidden md:inline">API-Key verwalten</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Column: Input & Capture (Col 1-5) -->
        <section class="lg:col-span-5 flex flex-col space-y-6">
            <div class="glass-panel rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gold-500/5 rounded-full blur-2xl pointer-events-none"></div>
                
                <h2 class="cinzel text-lg font-bold text-gold-300 mb-2 flex items-center space-x-2">
                    <i data-lucide="camera" class="w-5 h-5 text-gold-400"></i>
                    <span>Uhr erfassen</span>
                </h2>
                <p class="text-xs text-gray-400 mb-6">Fotografiere das Zifferblatt, die Lünette oder Details der Uhr für eine hochpräzise Bestimmung.</p>

                <!-- Tab selector -->
                <div class="grid grid-cols-2 gap-2 p-1 bg-watchdark-800 rounded-2xl mb-6 border border-gold-900/30">
                    <button id="tab-upload" onclick="switchTab('upload')" class="py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all bg-gold-500 text-black shadow-lg">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Datei-Upload</span>
                    </button>
                    <button id="tab-camera" onclick="switchTab('camera')" class="py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all text-gray-400 hover:text-white">
                        <i data-lucide="video" class="w-4 h-4"></i>
                        <span>Live-Kamera</span>
                    </button>
                </div>

                <!-- Upload Panel -->
                <div id="panel-upload" class="space-y-4">
                    <div id="drop-zone" class="border-2 border-dashed border-gold-500/30 hover:border-gold-500/60 transition-all rounded-2xl p-6 text-center cursor-pointer bg-watchdark-800/40 group relative">
                        <input type="file" id="file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" onchange="handleFileSelect(event)">
                        <div class="w-12 h-12 rounded-2xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center mx-auto mb-3 text-gold-400 group-hover:scale-105 transition-transform">
                            <i data-lucide="image-plus" class="w-6 h-6"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-200">Foto hierher ziehen oder <span class="text-gold-400 underline">durchsuchen</span></p>
                        <p class="text-[11px] text-gray-500 mt-1">PNG, JPG, WEBP bis zu 10MB</p>
                    </div>
                </div>

                <!-- Camera Panel -->
                <div id="panel-camera" class="hidden space-y-4">
                    <div class="relative rounded-2xl overflow-hidden bg-black aspect-square border border-gold-500/30 flex items-center justify-center">
                        <video id="camera-feed" autoplay playsinline class="w-full h-full object-cover"></video>
                        <canvas id="camera-canvas" class="hidden"></canvas>
                        <div id="camera-placeholder" class="absolute inset-0 flex flex-col items-center justify-center bg-watchdark-800 text-gray-400">
                            <i data-lucide="video-off" class="w-8 h-8 mb-2 text-gray-500"></i>
                            <span class="text-xs">Kamera ist deaktiviert</span>
                        </div>
                    </div>
                    <div class="flex space-x-2">
                        <button id="btn-toggle-cam" onclick="toggleCamera()" class="flex-1 py-2.5 rounded-xl bg-watchdark-700 hover:bg-watchdark-600 border border-gold-500/30 text-gold-300 font-medium text-xs flex items-center justify-center space-x-2 transition-all">
                            <i data-lucide="power" class="w-4 h-4"></i>
                            <span id="cam-toggle-text">Kamera starten</span>
                        </button>
                        <button id="btn-snapshot" onclick="takeSnapshot()" disabled class="px-4 py-2.5 rounded-xl bg-gold-500 text-black font-semibold text-xs flex items-center justify-center space-x-1 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                            <i data-lucide="camera" class="w-4 h-4"></i>
                            <span>Foto aufnehmen</span>
                        </button>
                    </div>
                </div>

                <!-- Preview Area -->
                <div id="preview-container" class="hidden mt-6 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Ausgewähltes Motiv</span>
                        <button onclick="clearImage()" class="text-xs text-red-400 hover:text-red-300 flex items-center space-x-1">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span>Entfernen</span>
                        </button>
                    </div>
                    <div class="relative rounded-2xl overflow-hidden aspect-video bg-black border border-gold-500/30 group">
                        <img id="image-preview" src="" alt="Uhren-Vorschau" class="w-full h-full object-contain">
                    </div>
                </div>

                <!-- Submit Action -->
                <button id="btn-analyze" onclick="analyzeWatch()" disabled class="w-full mt-6 py-3.5 rounded-2xl bg-gradient-to-r from-gold-600 to-gold-400 text-black font-bold text-sm tracking-wide shadow-lg hover:from-gold-500 hover:to-gold-300 transition-all flex items-center justify-center space-x-2 disabled:opacity-40 disabled:cursor-not-allowed">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    <span>Uhr analysieren</span>
                </button>
            </div>
        </section>

        <!-- Right Column: Results Dashboard (Col 6-12) -->
        <section class="lg:col-span-7 flex flex-col space-y-6">
            
            <!-- Initial State / Placeholder -->
            <div id="result-placeholder" class="glass-panel rounded-3xl p-12 text-center flex flex-col items-center justify-center flex-grow min-h-[450px]">
                <div class="w-20 h-20 rounded-3xl bg-gold-500/5 border border-gold-500/20 flex items-center justify-center text-gold-400 mb-4 animate-pulse">
                    <i data-lucide="compass" class="w-10 h-10"></i>
                </div>
                <h3 class="cinzel text-xl font-semibold text-gold-300 mb-2">Bereit für Horologie-Analyse</h3>
                <p class="text-sm text-gray-400 max-w-md mx-auto">Lade ein Foto hoch oder nimm ein Live-Bild deiner Uhr auf, um umfassende Details wie Referenznummer, Schätzung und Werksdaten abzurufen.</p>
            </div>

            <!-- Loading State -->
            <div id="result-loading" class="hidden glass-panel rounded-3xl p-12 text-center flex flex-col items-center justify-center flex-grow min-h-[450px]">
                <div class="relative w-20 h-20 mb-6">
                    <div class="absolute inset-0 rounded-full border-4 border-gold-500/20"></div>
                    <div class="absolute inset-0 rounded-full border-4 border-gold-400 border-t-transparent animate-spin"></div>
                    <div class="absolute inset-0 flex items-center justify-center text-gold-300">
                        <i data-lucide="watch" class="w-6 h-6 animate-pulse"></i>
                    </div>
                </div>
                <h3 class="cinzel text-lg font-semibold text-gold-300 mb-1" id="loading-status-title">Analysiere Horologie-Merkmale...</h3>
                <p class="text-xs text-gray-400" id="loading-status-desc">Gemini Vision untersucht Zifferblatt, Indizes, Zeiger und Gehäuseproportionen.</p>
            </div>

            <!-- Result Dashboard Content -->
            <div id="result-dashboard" class="hidden space-y-6">
                
                <!-- Hero Header Card -->
                <div class="glass-panel rounded-3xl p-6 sm:p-8 relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-6 opacity-10 pointer-events-none text-gold-300">
                        <i data-lucide="shield-check" class="w-24 h-24"></i>
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
                        <span id="res-brand" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-gold-500/10 text-gold-400 border border-gold-500/30">Rolex</span>
                        <div class="flex items-center space-x-2">
                            <span class="text-xs text-gray-400">Konfidenz:</span>
                            <span id="res-confidence" class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">98%</span>
                        </div>
                    </div>
                    <h2 id="res-model" class="cinzel text-2xl sm:text-3xl font-bold text-white mb-1">Submariner Date</h2>
                    <div class="flex items-center space-x-4 text-xs text-gold-300 font-mono">
                        <span>Ref. <span id="res-reference">126610LN</span></span>
                        <span>•</span>
                        <span id="res-year">Erscheinungsjahr: 2020</span>
                    </div>
                </div>

                <!-- Grid Details -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Wertschätzung -->
                    <div class="glass-panel rounded-2xl p-5 flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 flex-shrink-0">
                            <i data-lucide="badge-percent" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-[11px] uppercase tracking-wider text-gray-400 font-medium">Geschätzter Marktwert</span>
                            <h4 id="res-value" class="text-lg font-bold text-gold-300 font-mono">14.500 € – 16.200 €</h4>
                        </div>
                    </div>
                    <!-- Uhrwerk -->
                    <div class="glass-panel rounded-2xl p-5 flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 flex-shrink-0">
                            <i data-lucide="cog" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-[11px] uppercase tracking-wider text-gray-400 font-medium">Kaliber / Uhrwerk</span>
                            <h4 id="res-movement" class="text-sm font-bold text-gray-100">Cal. 3235 (Manufaktur)</h4>
                        </div>
                    </div>
                </div>

                <!-- Specifications Card -->
                <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-4">
                    <h3 class="cinzel text-sm font-bold text-gold-300 flex items-center space-x-2">
                        <i data-lucide="sliders" class="w-4 h-4 text-gold-400"></i>
                        <span>Technische Spezifikationen</span>
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div class="p-3.5 rounded-xl bg-watchdark-800/60 border border-gold-900/30 flex justify-between">
                            <span class="text-gray-400">Gehäusematerial:</span>
                            <span id="res-case" class="font-semibold text-gray-200">Oystersteel (904L)</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-watchdark-800/60 border border-gold-900/30 flex justify-between">
                            <span class="text-gray-400">Durchmesser:</span>
                            <span id="res-diameter" class="font-semibold text-gray-200">41 mm</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-watchdark-800/60 border border-gold-900/30 flex justify-between">
                            <span class="text-gray-400">Glas & Lünette:</span>
                            <span id="res-bezel" class="font-semibold text-gray-200">Saphirglas, Cerachrom-Keramik</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-watchdark-800/60 border border-gold-900/30 flex justify-between">
                            <span class="text-gray-400">Wasserdichtigkeit:</span>
                            <span id="res-water" class="font-semibold text-gray-200">300 Meter / 30 Bar</span>
                        </div>
                    </div>
                </div>

                <!-- History & Background -->
                <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-3">
                    <h3 class="cinzel text-sm font-bold text-gold-300 flex items-center space-x-2">
                        <i data-lucide="book-open" class="w-4 h-4 text-gold-400"></i>
                        <span>Modellgeschichte & Horologische Bedeutung</span>
                    </h3>
                    <p id="res-history" class="text-xs sm:text-sm text-gray-300 leading-relaxed">
                        Die Submariner gilt als Meilenstein in der Geschichte der Taucheruhren. Seit ihrer Einführung im Jahr 1953 hat sie den Standard für Robustheit, Wasserdichtigkeit und professionelle Instrumentenuhren weltweit geprägt.
                    </p>
                </div>

            </div>

        </section>

    </main>

    <!-- API Key Modal -->
    <div id="api-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-md w-full border border-gold-500/30 shadow-2xl space-y-5">
            <div class="flex items-center justify-between">
                <h3 class="cinzel text-lg font-bold text-gold-300">Gemini API-Key</h3>
                <button onclick="closeApiKeyModal()" class="text-gray-400 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <p class="text-xs text-gray-300">
                Gib deinen persönlichen Gemini API-Key ein, um die Vision-Modell-Analyse zu aktivieren. Den Key erhältst du kostenlos im <a href="https://aistudio.google.com/" target="_blank" class="text-gold-400 underline font-medium">Google AI Studio</a>.
            </p>
            <div class="space-y-2">
                <input type="password" id="api-key-input" placeholder="AIzaSy..." class="w-full bg-watchdark-800 border border-gold-500/30 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-gold-500">
            </div>
            <div class="flex space-x-3 pt-2">
                <button onclick="saveApiKey()" class="flex-1 py-3 rounded-xl bg-gold-500 text-black font-bold text-xs hover:bg-gold-400 transition-all">
                    Speichern
                </button>
                <button onclick="closeApiKeyModal()" class="px-4 py-3 rounded-xl bg-watchdark-700 text-gray-300 font-medium text-xs hover:bg-watchdark-600">
                    Abbrechen
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="glass-panel border-t border-gold-900/40 py-6 text-center text-xs text-gray-500 mt-auto">
        <p>Horologium • Angetrieben durch Gemini 3 Flash Vision API</p>
    </footer>

    <!-- App Logic -->
    <script>
        // Initialize Icons
        lucide.createIcons();

        let currentApiKey = localStorage.getItem('gemini_api_key') || '';
        let selectedFileBase64 = null;
        let selectedMimeType = null;
        let stream = null;

        // Check initial API Key state
        updateApiStatusUI();

        function updateApiStatusUI() {
            const badge = document.getElementById('api-status-badge');
            const text = document.getElementById('api-status-text');
            if (currentApiKey) {
                badge.className = "hidden sm:flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
                badge.querySelector('span').className = "w-2 h-2 rounded-full bg-emerald-400";
                text.textContent = "API-Key aktiv";
            } else {
                badge.className = "hidden sm:flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs bg-red-500/10 text-red-400 border border-red-500/30";
                badge.querySelector('span').className = "w-2 h-2 rounded-full bg-red-400";
                text.textContent = "API-Key fehlt";
            }
        }

        function openApiKeyModal() {
            document.getElementById('api-key-input').value = currentApiKey;
            document.getElementById('api-modal').classList.remove('hidden');
        }

        function closeApiKeyModal() {
            document.getElementById('api-modal').classList.add('hidden');
        }

        function saveApiKey() {
            const val = document.getElementById('api-key-input').value.trim();
            currentApiKey = val;
            localStorage.setItem('gemini_api_key', val);
            updateApiStatusUI();
            closeApiKeyModal();
        }

        // Tab Switching
        function switchTab(tab) {
            const tabUpload = document.getElementById('tab-upload');
            const tabCamera = document.getElementById('tab-camera');
            const panelUpload = document.getElementById('panel-upload');
            const panelCamera = document.getElementById('panel-camera');

            if (tab === 'upload') {
                tabUpload.className = "py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all bg-gold-500 text-black shadow-lg";
                tabCamera.className = "py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all text-gray-400 hover:text-white";
                panelUpload.classList.remove('hidden');
                panelCamera.classList.add('hidden');
                stopCamera();
            } else {
                tabCamera.className = "py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all bg-gold-500 text-black shadow-lg";
                tabUpload.className = "py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center space-x-2 transition-all text-gray-400 hover:text-white";
                panelCamera.classList.remove('hidden');
                panelUpload.classList.add('hidden');
                startCamera();
            }
        }

        // File Selection
        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            selectedMimeType = file.type;
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64Full = e.target.result;
                selectedFileBase64 = base64Full.split(',')[1];
                
                // Show Preview
                document.getElementById('image-preview').src = base64Full;
                document.getElementById('preview-container').classList.remove('hidden');
                document.getElementById('btn-analyze').removeAttribute('disabled');
            };
            reader.readAsDataURL(file);
        }

        // Camera Logic
        async function startCamera() {
            const video = document.getElementById('camera-feed');
            const placeholder = document.getElementById('camera-placeholder');
            const toggleText = document.getElementById('cam-toggle-text');
            const btnSnapshot = document.getElementById('btn-snapshot');

            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                video.srcObject = stream;
                placeholder.classList.add('hidden');
                toggleText.textContent = "Kamera stoppen";
                btnSnapshot.removeAttribute('disabled');
            } catch (err) {
                alert("Kamera konnte nicht gestartet werden: " + err.message);
            }
        }

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            const video = document.getElementById('camera-feed');
            video.srcObject = null;
            document.getElementById('camera-placeholder').classList.remove('hidden');
            document.getElementById('cam-toggle-text').textContent = "Kamera starten";
            document.getElementById('btn-snapshot').setAttribute('disabled', 'true');
        }

        function toggleCamera() {
            if (stream) {
                stopCamera();
            } else {
                startCamera();
            }
        }

        function takeSnapshot() {
            const video = document.getElementById('camera-feed');
            const canvas = document.getElementById('camera-canvas');
            canvas.width = video.videoWidth || 1280;
            canvas.height = video.videoHeight || 720;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            const dataUrl = canvas.toDataURL('image/jpeg');
            selectedMimeType = 'image/jpeg';
            selectedFileBase64 = dataUrl.split(',')[1];

            document.getElementById('image-preview').src = dataUrl;
            document.getElementById('preview-container').classList.remove('hidden');
            document.getElementById('btn-analyze').removeAttribute('disabled');
            stopCamera();
            switchTab('upload');
        }

        function clearImage() {
            selectedFileBase64 = null;
            selectedMimeType = null;
            document.getElementById('preview-container').classList.add('hidden');
            document.getElementById('btn-analyze').setAttribute('disabled', 'true');
            document.getElementById('file-input').value = '';
        }

        // Gemini Analysis
        async function analyzeWatch() {
            if (!currentApiKey) {
                alert("Bitte gib zuerst deinen Gemini API-Key ein.");
                openApiKeyModal();
                return;
            }
            if (!selectedFileBase64) {
                alert("Bitte wähle zuerst ein Bild aus.");
                return;
            }

            // UI State Loading
            document.getElementById('result-placeholder').classList.add('hidden');
            document.getElementById('result-dashboard').classList.add('hidden');
            document.getElementById('result-loading').classList.remove('hidden');

            const promptText = `Du bist ein weltklasse Uhren-Experte (Horologe). Analysiere dieses Uhrenfoto extrem präzise. 
Gib deine Antwort AUSSCHLIESSLICH im folgenden JSON-Format zurück (ohne Markdown-Backticks drumherum, reines JSON):
{
  "brand": "Markenname",
  "model": "Modellbezeichnung",
  "reference": "Referenznummer falls erkennbar oder 'Unbekannt / Variabel'",
  "year": "Erscheinungsjahr oder Epoche",
  "confidence": "Konfidenzwert in Prozent z.B. 96%",
  "estimatedValue": "Geschätzter Marktwert in Euro z.B. 8.000 € – 9.500 €",
  "movement": "Uhrwerk / Kaliber Beschreibung",
  "caseMaterial": "Gehäusematerial",
  "diameter": "Durchmesser in mm",
  "bezelAndGlass": "Glas & Lünette Details",
  "waterResistance": "Wasserdichtigkeit",
  "history": "Ausführliche und faszinierende Modellgeschichte und horologische Bedeutung (auf Deutsch, ca. 3-4 Sätze)."
}`;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${currentApiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [
                            {
                                parts: [
                                    { text: promptText },
                                    {
                                        inline_data: {
                                            mime_type: selectedMimeType,
                                            data: selectedFileBase64
                                        }
                                    }
                                ]
                            }
                        ]
                    })
                });

                if (!response.ok) {
                    throw new Error(`API Fehler: ${response.status} ${response.statusText}`);
                }

                const data = await response.json();
                const textResponse = data.candidates[0].content.parts[0].text;
                
                // Clean up potential markdown formatting in response
                const cleanedJson = textResponse.replace(/```json/g, '').replace(/```/g, '').trim();
                const watchData = JSON.parse(cleanedJson);

                // Populate UI
                document.getElementById('res-brand').textContent = watchData.brand || 'Unbekannt';
                document.getElementById('res-model').textContent = watchData.model || 'Unbekannte Uhr';
                document.getElementById('res-reference').textContent = watchData.reference || 'N/A';
                document.getElementById('res-year').textContent = `Epoche: ${watchData.year || 'N/A'}`;
                document.getElementById('res-confidence').textContent = watchData.confidence || '90%';
                document.getElementById('res-value').textContent = watchData.value || watchData.estimatedValue || 'Auf Anfrage';
                document.getElementById('res-movement').textContent = watchData.movement || 'N/A';
                document.getElementById('res-case').textContent = watchData.caseMaterial || 'N/A';
                document.getElementById('res-diameter').textContent = watchData.diameter || 'N/A';
                document.getElementById('res-bezel').textContent = watchData.bezelAndGlass || 'N/A';
                document.getElementById('res-water').textContent = watchData.waterResistance || 'N/A';
                document.getElementById('res-history').textContent = watchData.history || 'Keine historischen Daten verfügbar.';

                // Show Dashboard
                document.getElementById('result-loading').classList.add('hidden');
                document.getElementById('result-dashboard').classList.remove('hidden');

            } catch (error) {
                console.error(error);
                alert("Fehler bei der Analyse: " + error.message);
                document.getElementById('result-loading').classList.add('hidden');
                document.getElementById('result-placeholder').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
